<Window x:Class="FsClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FsClient"
        Title="fsclient 1.4.0" Width="1200" Height="800" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgMain}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        Closing="Window_Closing">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}">
            <Grid Margin="12,18,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="68" />
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="36" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8,0,0,12">
                    <Border Width="16" Height="2" CornerRadius="1" VerticalAlignment="Center"
                            Margin="0,0,8,0" Background="{StaticResource AccentBrush}" />
                    <TextBlock Text="ПРОДУКТЫ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextMuted}" />
                </StackPanel>

                <local:FrostedBorder x:Name="ZapretCard" Grid.Row="1" CornerRadius="14"
                                     Margin="0,0,0,8"
                                     BlurSource="{Binding ElementName=BlurSource}"
                                     Tint="#73141320" FrostBorderBrush="#24FFFFFF"
                                     Cursor="Hand" MouseLeftButtonUp="ZapretCard_Click"
                                     MouseEnter="ProductCard_MouseEnter"
                                     MouseLeave="ProductCard_MouseLeave">
                    <Grid Margin="12,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ZapretIcon" Width="34" Height="34" CornerRadius="10"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#66FFD9A0" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8A4B1E" Offset="0" />
                                    <GradientStop Color="#4A2410" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M13 2 L5 13 H11 L9 22 L19 10 H13 Z"
                                  Fill="#FFD9A0" Width="18" Height="18" Stretch="Uniform" />
                        </Border>
                        <Border x:Name="ZapretAccent" Width="3" Height="34" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="-12,0,0,0" Background="{StaticResource AccentBrush}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Zapret" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Ellipse x:Name="ZapretDot" Width="7" Height="7" Margin="0,0,6,0"
                                         Fill="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ZapretStatus" Text="Не скачано" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="ZapretMenuButton" Grid.Column="2" Content="⋯"
                                Width="26" Height="30" Padding="0" FontSize="16"
                                Foreground="{StaticResource TextSecondary}"
                                Style="{StaticResource PillButton}" HorizontalContentAlignment="Center"
                                Click="ZapretMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu Background="#1C192B" BorderBrush="#1AFFFFFF" BorderThickness="1">
                                    <MenuItem Header="Открыть папку" Click="MenuOpenFolder_Click" />
                                    <MenuItem Header="Проверить обновления" Click="MenuCheckUpdates_Click" />
                                    <MenuItem Header="Настройки" Click="MenuSettings_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </local:FrostedBorder>

                <local:FrostedBorder x:Name="TgCard" Grid.Row="2" CornerRadius="14"
                                     BlurSource="{Binding ElementName=BlurSource}"
                                     Tint="#73141320" FrostBorderBrush="#24FFFFFF"
                                     Cursor="Hand" MouseLeftButtonUp="TgCard_Click"
                                     MouseEnter="ProductCard_MouseEnter"
                                     MouseLeave="ProductCard_MouseLeave">
                    <Grid Margin="12,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="26" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TgIcon" Width="34" Height="34" CornerRadius="10"
                                BorderThickness="1" VerticalAlignment="Center">
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#669FC7FF" />
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2E3C7A" Offset="0" />
                                    <GradientStop Color="#1A2140" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M12 3 V12 M6 11 A7 7 0 0 0 18 11 M6 11 V17 A3 3 0 0 0 12 17 V11"
                                  Stroke="#BBD8FF" StrokeThickness="1.8" Width="18" Height="18"
                                  Stretch="Uniform" />
                        </Border>
                        <Border x:Name="TgAccent" Width="3" Height="34" CornerRadius="2"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="-12,0,0,0" Background="{StaticResource AccentBrush}"
                                Visibility="Collapsed" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TG-WS-Proxy" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <TextBlock x:Name="TgCardStatus" Text="MTProto-прокси" FontSize="11"
                                       Margin="0,4,0,0" Foreground="{StaticResource TextMuted}" />
                        </StackPanel>
                        <Button x:Name="TgMenuButton" Grid.Column="2" Content="⋯"
                                Style="{StaticResource PillButton}" HorizontalContentAlignment="Center"
                                Padding="0" Width="26" Height="30" FontSize="15"
                                Click="TgMenuButton_Click">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Открыть папку" Click="TgMenuOpenFolder_Click" />
                                    <MenuItem Header="Проверить обновления" Click="TgMenuCheckUpdates_Click" />
                                    <MenuItem Header="Скопировать ссылку" Click="TgMenuCopyLink_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </Grid>
                </local:FrostedBorder>

                <Button Grid.Row="4" Content="  GitHub Flowseal" Style="{StaticResource PillButton}"
                        HorizontalAlignment="Stretch" Height="36" Click="GitHub_Click" />

                <TextBlock Grid.Row="5" Text="fsclient v1.4.0" FontSize="10"
                           Foreground="#4A4558" Margin="10,8,0,0" />
            </Grid>
        </Border>

        <!-- Правая область -->
        <Grid Grid.Column="1">
            <!-- Скрытый слой: размытая копия фона для матового стекла -->
            <Grid x:Name="BlurHost" IsHitTestVisible="False">
                <Image x:Name="BlurSource"
                       Source="pack://application:,,,/assets/background.jpg"
                       Stretch="UniformToFill">
                    <Image.Effect>
                        <BlurEffect x:Name="BackgroundBlur" Radius="18" />
                    </Image.Effect>
                </Image>
            </Grid>

            <Image x:Name="BackgroundImage"
                   Source="pack://application:,,,/assets/background.jpg"
                   Stretch="UniformToFill" IsHitTestVisible="False" />
            <Rectangle Fill="{StaticResource OverlayBrush}" IsHitTestVisible="False" />

            <!-- Уведомление об обновлении лаунчера -->
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,64,0"
                  Panel.ZIndex="20">
                <Border x:Name="UpdateGlow" Height="36" CornerRadius="12" Opacity="0"
                        Background="#99FFB86B" IsHitTestVisible="False">
                    <Border.Effect>
                        <BlurEffect Radius="14" />
                    </Border.Effect>
                </Border>
                <Button x:Name="UpdateButton" Height="36" Padding="16,0"
                        Visibility="Collapsed" Style="{StaticResource UpdateButtonStyle}"
                        Click="UpdateButton_Click" ToolTip="Доступно обновление лаунчера"
                        MouseEnter="UpdateButton_MouseEnter" MouseLeave="UpdateButton_MouseLeave">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⬆" Margin="0,0,8,0" FontSize="15"
                                   Foreground="#FFD9A0" />
                        <TextBlock x:Name="UpdateButtonText" Text="Обновить"
                                   Foreground="#FFF3E0" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Настройки в правом верхнем углу -->
            <Button x:Name="SettingsButton" Content="⚙" Width="36" Height="36"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,18,0"
                    Panel.ZIndex="20" FontSize="18" Padding="0"
                    Foreground="{StaticResource TextPrimary}"
                    Style="{StaticResource IconButton}"
                    ToolTip="Настройки" Click="SettingsButton_Click" />

            <!-- Страница Zapret -->
            <Grid x:Name="ZapretPage">
                <Grid.RowDefinitions>
                    <RowDefinition Height="160" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,20,32,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="FLOWSEAL EDITION" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#EBFFFFFF" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                            <TextBlock Text="DPI BYPASS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#EBFFFFFF" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="52" Height="52" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC7C5CFF" Offset="0" />
                                    <GradientStop Color="#DCA64B63" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M13 2 L5 13 H11 L9 22 L19 10 H13 Z"
                                  Fill="White" Width="30" Height="30" Stretch="Uniform" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Zapret" FontSize="32" FontWeight="ExtraBold"
                                       Foreground="White" />
                            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="#D9FFFFFF"
                                       Text="Инструмент обхода блокировок Discord и YouTube. Выберите релиз и запустите нужную стратегию в один клик." />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="32,0,32,8">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220">
                            <Button x:Name="MainButton" Style="{StaticResource AccentButton}"
                                    Width="220" Click="MainButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path x:Name="MainIcon" Width="18" Height="18" Margin="0,0,10,0"
                                          Fill="White" Stretch="Uniform" VerticalAlignment="Center"
                                          Data="M12 4 V16 M7 12 L12 17 L17 12 M5 20 H19" />
                                    <TextBlock x:Name="MainButtonText" Grid.Column="1" Text="Скачать"
                                               VerticalAlignment="Center" Foreground="White" />
                                </Grid>
                            </Button>
                            <Button x:Name="LastStrategyButton" Style="{StaticResource SecondaryButton}"
                                    Width="220" Height="36" Margin="0,6,0,0"
                                    Visibility="Collapsed" Click="LastStrategyButton_Click">
                                <TextBlock x:Name="LastStrategyButtonText" Text="Запустить последнюю"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Button>
                        </StackPanel>

                        <StackPanel Margin="12,0,0,0" Width="220">
                            <ComboBox x:Name="ReleaseCombo" Style="{StaticResource DarkCombo}"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="ReleaseCombo_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" FontSize="12"
                                                   Foreground="{StaticResource TextPrimary}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox x:Name="AutoRunStrategyCheck" Margin="0,6,0,0" FontSize="11"
                                      Foreground="{StaticResource TextSecondary}"
                                      Checked="AutoRunStrategyCheck_Changed"
                                      Unchecked="AutoRunStrategyCheck_Changed">
                                <CheckBox.Content>
                                    <TextBlock Text="Запускать последнюю стратегию с лаунчером"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondary}" />
                                </CheckBox.Content>
                            </CheckBox>
                        </StackPanel>

                        <local:FrostedButton x:Name="FolderButton"
                                 BlurSource="{Binding ElementName=BlurSource}"
                                 Tint="#73141320" FrostBorderBrush="#24FFFFFF"
                                 Width="56" Height="56" Margin="12,0,0,0" Click="FolderButton_Click"
                                 ToolTip="Открыть папку релиза">
                            <Path Data="M4 7 H10 L12 9 H21 V19 H4 Z" Width="22" Height="22"
                                  Stroke="{StaticResource TextPrimary}" StrokeThickness="1.8"
                                  Stretch="Uniform" />
                        </local:FrostedButton>

                        <local:FrostedButton x:Name="StopButton"
                                BlurSource="{Binding ElementName=BlurSource}"
                                Tint="#73141320" FrostBorderBrush="#24FFFFFF"
                                Width="150" Height="56" Margin="12,0,0,0" Visibility="Collapsed"
                                Click="StopButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M8 8 H20 V20 H8 Z" Width="16" Height="16"
                                      Fill="{StaticResource TextPrimary}" Stretch="Uniform" />
                                <TextBlock Text="Остановить" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </local:FrostedButton>
                    </StackPanel>

                    <Border x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <StackPanel>
                            <local:RoundedProgressBar x:Name="DownloadProgress"
                                                      Minimum="0" Maximum="100" />
                            <TextBlock x:Name="ProgressLabel" Text="Скачивание..." Margin="0,6,0,0"
                                       FontSize="11" Foreground="{StaticResource TextSecondary}" />
                        </StackPanel>
                    </Border>

                    <local:FrostedBorder Height="44" CornerRadius="12" Margin="0,10,0,0"
                                         BlurSource="{Binding ElementName=BlurSource}"
                                         Tint="#73141320" FrostBorderBrush="#24FFFFFF">
                        <Grid>
                            <Ellipse x:Name="ConsoleDot" Width="8" Height="8" Margin="20,0,0,0"
                                     Fill="{StaticResource TextMuted}" HorizontalAlignment="Left" />
                            <TextBlock x:Name="ConsoleText" Text="Ожидание..." Margin="38,0,16,0"
                                       FontFamily="Consolas" FontSize="10" Foreground="#B8B2CC"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </local:FrostedBorder>

                    <TabControl Height="44" Margin="0,10,0,0" Background="Transparent">
                        <TabItem Header="Плагины" />
                    </TabControl>
                </StackPanel>

                <Grid Grid.Row="2" Margin="32,20,32,16">
                    <local:FrostedBorder Style="{StaticResource DevCard}"
                                         BlurSource="{Binding ElementName=BlurSource}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="В разработке" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </local:FrostedBorder>
                </Grid>
            </Grid>

            <!-- Страница TG WS Proxy: управляет официальной сборкой Flowseal -->
            <Grid x:Name="TgWsPage" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="32,18,78,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="FLOWSEAL BUILD" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#EBFFFFFF" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                            <TextBlock Text="LOCAL MTPROTO" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#EBFFFFFF" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Border Width="50" Height="50" CornerRadius="12">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#DC34D3EE" Offset="0" />
                                    <GradientStop Color="#DC7C5CFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Path Data="M12 3 V12 M6 11 A7 7 0 0 0 18 11 M6 11 V17 A3 3 0 0 0 12 17 V11"
                                  Stroke="White" StrokeThickness="1.8" Width="28" Height="28"
                                  Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="TG WS Proxy" FontSize="30" FontWeight="ExtraBold"
                                       Foreground="White" />
                            <TextBlock Margin="0,4,0,0" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="#D9FFFFFF"
                                       Text="Официальная сборка Flowseal. Лаунчер скачивает версии, пишет конфиг и управляет процессом." />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <local:FrostedBorder Grid.Row="1" Margin="32,0,32,8" CornerRadius="14"
                                     BlurSource="{Binding ElementName=BlurSource}"
                                     Tint="#73141320" FrostBorderBrush="#24FFFFFF">
                    <StackPanel Margin="18,14">
                        <StackPanel Orientation="Horizontal">
                            <ComboBox x:Name="TgReleaseCombo" Style="{StaticResource DarkCombo}"
                                      Width="260" DisplayMemberPath="Display"
                                      SelectionChanged="TgReleaseCombo_SelectionChanged" />
                            <StackPanel Width="210" Margin="12,0,0,0">
                                <Button x:Name="TgMainButton" Style="{StaticResource AccentButton}"
                                        Width="210" Click="TgMainButton_Click">
                                    <TextBlock x:Name="TgMainButtonText" Text="Скачать" />
                                </Button>
                                <Button x:Name="TgOptionsButton" Style="{StaticResource SecondaryButton}"
                                        Width="210" Height="36" Margin="0,6,0,0"
                                        Click="TgOptionsButton_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TgOptionsButtonText" Text="Параметры"
                                                   Foreground="{StaticResource TextPrimary}" />
                                        <Path x:Name="TgOptionsChevron" Margin="8,0,0,0"
                                              Width="10" Height="10" Stretch="Uniform"
                                              Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6"
                                              Data="M2 4 L6 8 L10 4" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <Button x:Name="TgStopButton" Style="{StaticResource SecondaryButton}"
                                    Width="120" Height="56" Margin="10,0,0,0" Click="TgStopButton_Click"
                                    Visibility="Collapsed">
                                <TextBlock Text="Остановить" />
                            </Button>
                        </StackPanel>

                        <Border x:Name="TgProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
                            <StackPanel>
                                <local:RoundedProgressBar x:Name="TgDownloadProgress"
                                                          Minimum="0" Maximum="100" />
                                <TextBlock x:Name="TgProgressLabel" Text="Скачивание..."
                                           Margin="0,6,0,0" FontSize="11"
                                           Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="0,0,14,0">
                                <Ellipse x:Name="TgStatusDot" Width="8" Height="8"
                                         Fill="{StaticResource TextMuted}" />
                                <TextBlock x:Name="TgStatusText" Text="Не запущен" Margin="8,0,0,0"
                                           FontSize="12" Foreground="{StaticResource TextSecondary}" />
                            </StackPanel>
                            <TextBox x:Name="TgLinkBox" Grid.Column="1" Style="{StaticResource DarkTextInput}"
                                     IsReadOnly="True" Text="tg://proxy?..." TextWrapping="Wrap"
                                     AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                                     MinHeight="38" MaxHeight="58" />
                            <Button x:Name="TgCopyLinkButton" Grid.Column="2" Content="Копировать"
                                    Style="{StaticResource SecondaryButton}" Height="34"
                                    Padding="12,0" Margin="10,0,0,0" Click="TgCopyLink_Click" />
                        </Grid>

                        <!-- Все настройки прокси скрываются за кнопкой «Параметры» -->
                        <StackPanel x:Name="TgOptionsPanel" Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="АДРЕС" FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" Margin="2,0,0,5" />
                                    <TextBox x:Name="TgHostBox" Style="{StaticResource DarkTextInput}"
                                             Text="127.0.0.1" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="ПОРТ" FontSize="10"
                                               Foreground="{StaticResource TextSecondary}" Margin="2,0,0,5" />
                                    <TextBox x:Name="TgPortBox" Style="{StaticResource DarkTextInput}"
                                             Text="1443" />
                                </StackPanel>
                                <Button x:Name="TgSaveConfigButton" Grid.Column="2" Content="Сохранить"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        Margin="10,18,0,0" Padding="12,0" Click="TgSaveConfig_Click" />
                                <Button x:Name="TgRegenButton" Grid.Column="3" Content="Новый secret"
                                        Style="{StaticResource SecondaryButton}" Height="38"
                                        Margin="8,18,0,0" Padding="12,0" Click="TgRegenSecret_Click" />
                            </Grid>

                            <WrapPanel Margin="0,12,0,0">
                                <CheckBox x:Name="TgCfProxyCheck" Content="Cloudflare fallback"
                                          Style="{StaticResource DarkCheckBox}" Margin="0,0,20,0"
                                          IsChecked="True" />
                                <CheckBox x:Name="TgH2Check" Content="HTTP/2 media"
                                          Style="{StaticResource DarkCheckBox}" Margin="0,0,20,0"
                                          IsChecked="True" />
                                <CheckBox x:Name="TgNoSecureCheck" Content="CF через 80 порт"
                                          Style="{StaticResource DarkCheckBox}" Margin="0,0,20,0" />
                                <CheckBox x:Name="TgForceTestCheck" Content="Test DC"
                                          Style="{StaticResource DarkCheckBox}" />
                            </WrapPanel>

                            <TextBlock Margin="0,12,0,4" FontSize="10"
                                       Foreground="{StaticResource TextSecondary}"
                                       Text="СЕКРЕТ (для ручного подключения в Telegram)" />
                            <TextBox x:Name="TgSecretBox" Style="{StaticResource DarkTextInput}"
                                     IsReadOnly="True" Text="" />
                        </StackPanel>
                    </StackPanel>
                </local:FrostedBorder>

                <Grid Grid.Row="2" Margin="32,8,32,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="276" />
                    </Grid.ColumnDefinitions>

                    <local:FrostedBorder CornerRadius="14"
                                         BlurSource="{Binding ElementName=BlurSource}"
                                         Tint="#73141320" FrostBorderBrush="#24FFFFFF">
                        <Grid Margin="18,14">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Подключение и журнал" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />

                            <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="10"
                                    Background="#0F0E17" BorderBrush="#14FFFFFF" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="30" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ЖУРНАЛ ПРОКСИ" Margin="12,0,0,0"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextMuted}"
                                               VerticalAlignment="Center" />
                                    <TextBox x:Name="TgLogText" Grid.Row="1" Margin="4,0,4,4"
                                             Background="Transparent" Foreground="#B8B2CC"
                                             BorderThickness="0" Padding="8,4" IsReadOnly="True"
                                             FontFamily="Consolas" FontSize="11"
                                             TextWrapping="NoWrap" AcceptsReturn="True"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto" />
                                </Grid>
                            </Border>
                        </Grid>
                    </local:FrostedBorder>

                    <local:FrostedBorder Grid.Column="1" Margin="14,0,0,0" CornerRadius="14"
                                         BlurSource="{Binding ElementName=BlurSource}"
                                         Tint="#73141320" FrostBorderBrush="#24FFFFFF">
                        <StackPanel Margin="16,14">
                            <TextBlock Text="Действия" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" />
                            <Button Content="Открыть в Telegram" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,14,0,0" Click="TgOpenTelegram_Click" />
                            <Button Content="Перезапустить прокси" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,8,0,0" Click="TgRestart_Click" />
                            <Button Content="Папка версии" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,8,0,0" Click="TgOpenFolder_Click" />
                            <Button Content="Открыть лог" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,8,0,0" Click="TgOpenLog_Click" />
                            <Button Content="Релизы Flowseal" Style="{StaticResource SecondaryButton}"
                                    Height="40" Margin="0,8,0,0" Click="TgReleasesPage_Click" />
                            <TextBlock Margin="0,16,0,0" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       Text="Сборка работает локально. Изменения конфига применяются после перезапуска прокси." />
                        </StackPanel>
                    </local:FrostedBorder>
                </Grid>
            </Grid>
        </Grid>

        <!-- Интро FSCLIENT -->
        <Grid x:Name="SplashOverlay" Grid.ColumnSpan="2" Panel.ZIndex="1000" Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#141220" Offset="0" />
                    <GradientStop Color="#0E0D15" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel x:Name="SplashLetters" Orientation="Horizontal"
                             HorizontalAlignment="Center" />
                <TextBlock x:Name="SplashStatus" Margin="0,26,0,0"
                           HorizontalAlignment="Center" FontSize="13"
                           Foreground="#B8B2CC" Text="Подготовка..." />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

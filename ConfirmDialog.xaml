<Window x:Class="FsClient.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Background="#99060A0F" Foreground="#F4F2FA" FontFamily="Segoe UI" FontSize="13">

    <Border Width="440" CornerRadius="16" Background="#1C192B"
            BorderBrush="#1AFFFFFF" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Margin="24,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Заменить активную службу?" FontSize="16" FontWeight="Bold" />

            <TextBlock Grid.Row="1" Margin="0,14,0,0" FontSize="13" TextWrapping="Wrap"
                       Foreground="#9E97B8">
                <Run Text="Служба «" /><Run x:Name="CurrentServiceRun" /><Run Text="» уже установлена." />
                <LineBreak />
                <Run Text="Хотите удалить текущую службу и применить стратегию «" /><Run x:Name="NewStrategyRun" /><Run Text="»?" />
            </TextBlock>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Отмена" Width="100" Height="38"
                        Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />
                <Button Content="Да, заменить" Width="130" Height="38" Margin="10,0,0,0"
                        Background="{StaticResource DangerSolid}"
                        Style="{StaticResource AccentButton}" Click="Confirm_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>

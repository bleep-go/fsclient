<Window x:Class="FsClient.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FsClient"
        Title="Обновление" Width="760" Height="620"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#01000000" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">

    <Grid Margin="14">
        <local:FrostedBorder CornerRadius="18" Tint="#F41A1724"
                             FrostBorderBrush="#3CFFFFFF">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0" Margin="28,24,28,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44" Height="44" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF8A4B1E" Offset="0" />
                                <GradientStop Color="#FF4A2410" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="⬆" FontSize="22" Foreground="#FFD9A0"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Доступно обновление"
                                   FontSize="19" FontWeight="Bold" Foreground="White" />
                        <TextBlock x:Name="SubtitleText" FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="8"
                            Padding="10,5" Background="#33FFB86B">
                        <TextBlock x:Name="VersionBadge" Text="v1.4.0" FontSize="11"
                                   FontWeight="SemiBold" Foreground="#CFF7DF" />
                    </Border>
                </Grid>

                <!-- Changelog из GitHub -->
                <local:FrostedBorder Grid.Row="1" Margin="28,0,28,10" CornerRadius="12"
                                     Tint="#99100E16" FrostBorderBrush="#24FFFFFF">
                    <Grid Margin="14,12,14,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="ЧЕНДЖЛОГ РЕЛИЗА" FontSize="10"
                                   FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                   Margin="4,0,0,8" />

                        <FlowDocumentScrollViewer x:Name="NotesViewer" Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto"
                                                  IsSelectionEnabled="True" />
                    </Grid>
                </local:FrostedBorder>

                <!-- Низ -->
                <Grid Grid.Row="2" Margin="28,0,28,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="AutoHint" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextMuted}"
                                   Visibility="Collapsed"
                                   Text="Автообновление включено — новая версия установится сама при следующем запуске." />
                        <TextBlock FontSize="11" Margin="0,2,0,0">
                            <Hyperlink x:Name="ReleaseLink" Click="ReleaseLink_Click"
                                       Foreground="#9FC7FF" TextDecorations="None">
                                Открыть релиз на GitHub
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <Button x:Name="CancelButton" Grid.Column="1" Content="Позже"
                            Width="110" Height="42" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}" Click="Cancel_Click" />

                    <Button x:Name="InstallButton" Grid.Column="2" Content="Обновить"
                            Width="150" Height="42" Padding="16,0"
                            Style="{StaticResource UpdateButtonStyle}" Click="Install_Click" />
                </Grid>
            </Grid>
        </local:FrostedBorder>
    </Grid>
</Window>

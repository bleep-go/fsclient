<Window x:Class="FsClient.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FsClient"
        Title="Настройки" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Width="760" Height="540" Background="#01000000"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Height="40"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26405EFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Акрил размывает всё, что находится за окном; собственных обоев нет -->
    <local:FrostedBorder CornerRadius="16" Margin="0"
                         Tint="#3D141320" FrostBorderBrush="#24FFFFFF">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="72" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="22,0,22,0">
                <TextBlock Text="Настройки" FontSize="17" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Button Content="✕" Width="30" Height="30" Padding="0" FontSize="14"
                        Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right"
                        Style="{StaticResource IconButton}"
                        Click="Close_Click" />
            </Grid>
            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Margin="22,0,22,0"
                    Background="#14FFFFFF" />

            <!-- Категории и содержимое -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="178" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:FrostedBorder Grid.Column="0" Margin="12,12,6,12" CornerRadius="10"
                                     Tint="#4A141320" FrostBorderBrush="#1AFFFFFF">
                    <StackPanel Margin="0,6,0,0">
                        <TextBlock Text="КАТЕГОРИИ" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextMuted}" Margin="14,0,0,10" />
                        <Button x:Name="GeneralTab" Content="  Общие" Style="{StaticResource CategoryButton}"
                                Background="#407C5CFF" Foreground="{StaticResource TextPrimary}"
                                Click="GeneralTab_Click" />
                        <Button x:Name="AppearanceTab" Content="  Внешний вид" Style="{StaticResource CategoryButton}"
                                Margin="0,6,0,0" Click="AppearanceTab_Click" />
                    </StackPanel>
                </local:FrostedBorder>

                <local:FrostedBorder Grid.Column="1" Margin="6,12,12,12" CornerRadius="10"
                                     Tint="#4A141320" FrostBorderBrush="#1AFFFFFF">
                    <ScrollViewer Margin="16,14,16,14" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Общие -->
                            <StackPanel x:Name="GeneralPanel">
                                <TextBlock Text="Папка данных" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Margin="0,5,0,12" FontSize="11.5" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondary}"
                                           Text="Сюда помещаются загрузки, плагины, логи и картинка фона. По умолчанию: %ProgramFiles%\fsclient\1.1.0" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DataRootBox" Grid.Column="0" IsReadOnly="True"
                                             Style="{StaticResource DarkTextInput}" />
                                    <Button Grid.Column="1" Content="Обзор..." Width="110" Height="42"
                                            Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                            Click="Browse_Click" />
                                </Grid>

                                <local:FrostedBorder Margin="0,14,0,0" CornerRadius="8" Padding="12,10"
                                                     Tint="#66207C5C" FrostBorderBrush="#33207C5C">
                                    <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="#B9E8D6"
                                               Text="При смене папки все файлы сначала копируются в новую директорию, проверяются, и только после этого старая папка удаляется. Конфиг остаётся в %LOCALAPPDATA%\fsclient\1.1.0." />
                                </local:FrostedBorder>

                                <TextBlock x:Name="GeneralHint" Margin="0,12,0,0" FontSize="11"
                                           Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Внешний вид -->
                            <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                                <TextBlock Text="Размытие фона" FontSize="14" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="46" />
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BlurSlider" Minimum="0" Maximum="30" TickFrequency="1"
                                            IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                            Style="{StaticResource GlassSlider}"
                                            ValueChanged="BlurSlider_ValueChanged" />
                                    <TextBlock x:Name="BlurValue" Grid.Column="1" Text="18"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Grid>

                                <TextBlock Text="Заголовок окна" FontSize="14" FontWeight="SemiBold" />
                                <TextBox x:Name="TitleBox" Margin="0,10,0,18"
                                         Style="{StaticResource DarkTextInput}" />

                                <TextBlock Text="Картинка заднего фона" FontSize="14" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="BackgroundBox" Grid.Column="0" IsReadOnly="True"
                                             Text="Встроенная" Style="{StaticResource DarkTextInput}" />
                                    <Button Grid.Column="1" Content="Выбрать..." Width="110" Height="42"
                                            Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                                            Click="PickBackground_Click" />
                                    <Button Grid.Column="2" Content="Сбросить" Width="100" Height="42"
                                            Margin="8,0,0,0" Style="{StaticResource PillButton}"
                                            Click="ResetBackground_Click" />
                                </Grid>
                                <TextBlock Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextMuted}"
                                           Text="Файл копируется в папку данных (assets) и сохраняется между запусками." />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </local:FrostedBorder>
            </Grid>

            <!-- Подвал -->
            <Grid Grid.Row="2" Margin="22,0,22,0">
                <TextBlock x:Name="StatusText" FontSize="11" TextWrapping="Wrap"
                           Foreground="{StaticResource TextMuted}" MaxWidth="420"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Width="110" Height="42" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" />
                    <Button x:Name="SaveButton" Content="Сохранить" Width="130" Height="42" Margin="10,0,0,0"
                            Style="{StaticResource AccentButton}" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </local:FrostedBorder>
</Window>

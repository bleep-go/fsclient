<Window x:Class="FsClient.StrategyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор стратегии" WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="Manual" ResizeMode="NoResize"
        Background="#99060A0F" Foreground="#F4F2FA" FontFamily="Segoe UI" FontSize="13">

    <Border Width="460" MaxHeight="430" CornerRadius="16" Background="#1C192B"
            BorderBrush="#1AFFFFFF" BorderThickness="1"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Выберите стратегию запуска" FontSize="16" FontWeight="Bold"
                       VerticalAlignment="Center" />
            <Button Content="✕" Width="28" Height="28" Padding="0" FontSize="14"
                    Foreground="#9E97B8" HorizontalAlignment="Right"
                    Style="{StaticResource PillButton}" HorizontalContentAlignment="Center"
                    Click="Close_Click" />

            <Border x:Name="ServiceHint" Grid.Row="1" Visibility="Collapsed" Margin="0,12,0,0"
                    CornerRadius="6" Background="#1A4ADE80" BorderBrush="#404ADE80" BorderThickness="1"
                    Padding="10,6">
                <TextBlock x:Name="ServiceHintText" FontSize="11" Foreground="#4ADE80" />
            </Border>

            <ListBox x:Name="StrategiesList" Grid.Row="2" Margin="0,14,0,0"
                     Background="#05FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1"
                     MinHeight="220" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="#F4F2FA" />
                        <Setter Property="Padding" Value="12,10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#1F7C5CFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#407C5CFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Запустить" Width="120" Height="40"
                        Style="{StaticResource SecondaryButton}" Click="Run_Click" />
                <Button Content="Установить службу" Width="160" Height="40" Margin="10,0,0,0"
                        Style="{StaticResource AccentButton}" Click="Install_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
